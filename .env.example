# ==============================================================================
# SAMVEDNA AI - Environment Configuration Template
# ==============================================================================

# Groq API Configuration (Fast Open-Source Models on LPU)
# Sign up and obtain key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Sarvam AI STT Configuration (Saaras v3 Indic Speech-to-Text)
# Sign up and obtain key at: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=saaras:v3
SARVAM_MODE=verbatim

# Application Server Settings
PORT=8000
HOST=0.0.0.0
ENABLE_NOISE_GATE=True

# Neon PostgreSQL Cloud Database (Authorities & District Sentinel Portal)
# Create a free database at: https://neon.tech
NEON_DATABASE_URL=postgresql://user:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

